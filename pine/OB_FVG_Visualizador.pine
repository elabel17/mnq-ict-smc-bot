//@version=6
indicator("OB + FVG Visualizador (motor Python)", overlay=true, max_boxes_count=500, max_lines_count=200, max_labels_count=200)

// ============================================================================
// Replica EXACTA de la deteccion usada en el motor de Python
// (data/engine/python/motor_confluencia.py). Lo que se ve aqui es, vela por
// vela, lo mismo que el backtester esta usando -- para auditar visualmente
// si la deteccion tiene sentido antes de seguir optimizando a ciegas.
//
// Nada de esto es look-ahead: cada zona se dibuja al cerrar la vela que la
// genera, igual que en Python. La frescura (edad maxima) se muestra con la
// opacidad de la caja: mas transparente = mas vieja.
// ============================================================================

// ---------------- inputs: deteccion de OB ----------------
grpOB = "Order Block (desplazamiento)"
dispLen    = input.int(20, "Velas para rango promedio", group=grpOB)
dispMult   = input.float(1.5, "Umbral desplazamiento (x rango prom.)", step=0.1, group=grpOB)
dispFrac   = input.float(0.6, "Fraccion de cierre direccional", step=0.05, group=grpOB)
obScan     = input.int(10, "Velas atras para vela de origen", group=grpOB)
liqWin     = input.int(12, "Ventana de liquidez", group=grpOB)
liqTol     = input.float(4.0, "Tolerancia de liquidez (pts)", group=grpOB)
liqAccum   = input.int(6, "Racha que invalida (liquidez sucia)", group=grpOB)
edadMax    = input.int(12, "Frescura operable del BACKTEST (velas, referencia)", group=grpOB)
aplicarFrescura = input.bool(false, "Aplicar ese limite al VISUAL (si no, solo invalida el precio)", group=grpOB)
verTodo    = input.bool(true, "Mostrar TODO lo detectado, no solo lo operable (auditoria)", group=grpOB)
vidaFantasma = input.int(15, "Velas visible tras mitigarse (0 = borrar al instante)", group=grpOB)

grpBOS = "Order Block (ruptura de estructura interna)"
usarBOS    = input.bool(true, "Tambien detectar por BOS (estructura interna)", group=grpBOS)
pivLado    = input.int(2, "Velas a cada lado del pivote interno", group=grpBOS)

grpFVG = "Fair Value Gap"
mostrarFVG = input.bool(true, "Mostrar FVG", group=grpFVG)
minGap     = input.float(0.0, "Hueco minimo (pts)", group=grpFVG)
exigirFVG  = input.bool(true, "Marcar solo OB con FVG solapado (confluencia)", group=grpFVG)

grpSes = "Sesion (hora NY)"
sesIni     = input.session("0800-1300", "Ventana operable (NY)", group=grpSes)
mostrarSesion = input.bool(true, "Sombrear la sesion", group=grpSes)

grpLiq = "Liquidez (pivotes + iguales)"
mostrarLiq  = input.bool(true, "Mostrar niveles de liquidez", group=grpLiq)
liqLado     = input.int(8, "Velas a cada lado del pivote", group=grpLiq)
liqEdadMax  = input.int(60, "Vencer nivel tras N velas sin barrer", group=grpLiq)
eqTol       = input.float(3.0, "Tolerancia para 'iguales' (pts)", group=grpLiq)

grpFuerza = "Fuerza de reaccion (score compuesto)"
mostrarFuerza = input.bool(true, "Mostrar % de fuerza dentro de la caja", group=grpFuerza)
fuerzaMinima  = input.int(0, "Ocultar zonas con fuerza menor a (%)", minval=0, maxval=100, group=grpFuerza)
usarSesgo1H   = input.bool(true, "Incluir sesgo de 1H en el score", group=grpFuerza)
biasSmaLen    = input.int(10, "SMA del sesgo de 1H (velas de 1H)", group=grpFuerza)
liqCercaPts   = input.float(3.0, "Distancia max. a un barrido reciente para contar (pts, x eqTol)", group=grpFuerza)
liqVentanaBar = input.int(30, "Considerar barridos de los ultimos N eventos", group=grpFuerza)

// ---------------- rango promedio (igual a _avg_range) ----------------
rng = high - low
avgRng = ta.sma(rng, dispLen)[1]   // shift 1: el mismo avg[i-1] que usa Python
avgVol = ta.sma(volume, dispLen)[1]

// Sesgo de 1H (igual metodo que las estrategias reales: SMA de cierres de
// velas de 1H completas, sin lookahead)
h1Bias = usarSesgo1H ? request.security(syminfo.tickerid, "60", math.sign(close - ta.sma(close, biasSmaLen)), lookahead=barmerge.lookahead_off) : 0.0

// ============================================================================
// SCORE DE FUERZA (0-100%): combina 5 factores que el indicador YA calcula
// por separado, ponderados. Cada uno se conoce sin mirar al futuro en el
// momento en que la zona nace (el de FVG puede subir mas tarde, cuando el
// hueco aparece -- ver bloque de confluencia FVG mas abajo, que actualiza el
// texto). No es el algoritmo de ningun indicador de terceros, es una metrica
// propia para el mismo problema (auditar visualmente que tan "real" luce
// cada OB), documentada aqui para poder auditarla o ajustar los pesos.
//
//   30% volumen de la vela disparadora vs su promedio (participacion real)
//   20% cuanto se paso del umbral de desplazamiento (violencia del movimiento)
//   20% liquidez: 100% si nace justo tras un barrido confirmado a su favor,
//       0% si queda liquidez SIN cazar cerca del borde lejano (riesgo de
//       que el precio atraviese la zona para ir a buscarla) o si no hay
//       ninguna senal clara (sin neutral intermedio, ver liqComponenteDe)
//   15% alineacion con el sesgo de 1H (a favor / neutro / en contra)
//   15% confluencia con un FVG que se solape con la zona (se suma despues, si aparece)
// ============================================================================
volScoreDe(volRatio) => math.min(100.0, math.max(0.0, (volRatio - 1.0) / 2.0 * 100))          // 1x=0%, 3x+=100%
rngScoreDe(rngRatio) => math.min(100.0, math.max(0.0, (rngRatio - dispMult) / dispMult * 100)) // en el umbral=0%, al doble=100%
biasScoreDe(dir, bias) =>
    not usarSesgo1H or bias == 0 ? 50.0 : (dir == 1 and bias > 0) or (dir == -1 and bias < 0) ? 100.0 : 0.0

combinarFuerza(volS, rngS, liqS, biasS, fvgS) =>
    math.round(volS * 0.30 + rngS * 0.20 + liqS * 0.20 + biasS * 0.15 + fvgS * 0.15)

// ---------------- deteccion por DESPLAZAMIENTO ----------------
isDisp = not na(avgRng) and rng >= dispMult * avgRng
bullDisp = isDisp and close > open and (close - low) >= dispFrac * rng
bearDisp = isDisp and close < open and (high - close) >= dispFrac * rng

// vela de origen: ultima vela opuesta dentro de obScan velas atras
findOrigenAlcista() =>
    idx = -1
    for k = 1 to obScan
        if close[k] < open[k]
            idx := k
            break
    idx
findOrigenBajista() =>
    idx = -1
    for k = 1 to obScan
        if close[k] > open[k]
            idx := k
            break
    idx

// filtro de liquidez: racha de velas que se acercaron al nivel del origen
liqLimpiaAlcista(cand) =>
    mx = 0
    cu = 0
    for j = 1 to liqWin
        if low[j] <= cand + liqTol
            cu += 1
            mx := math.max(mx, cu)
        else
            cu := 0
    mx < liqAccum
liqLimpiaBajista(cand) =>
    mx = 0
    cu = 0
    for j = 1 to liqWin
        if high[j] >= cand - liqTol
            cu += 1
            mx := math.max(mx, cu)
        else
            cu := 0
    mx < liqAccum

// historial acotado de barridos de liquidez (poblado mas abajo, en el bloque
// LIQUIDEZ) para poder puntuar si un OB nace justo despues de un barrido a
// su favor -- dir guardada es la direccion de OB que ese barrido soporta:
// 1 (barrido de MINIMOS, favorece OB alcista), -1 (barrido de MAXIMOS,
// favorece OB bajista)
var array<int>   sweepBar   = array.new<int>()
var array<float> sweepPrice = array.new<float>()
var array<int>   sweepDir   = array.new<int>()

// niveles de liquidez TODAVIA sin barrer (poblados mas abajo, en el bloque
// LIQUIDEZ) -- se declaran aqui arriba para poder consultarlos al puntuar
// un OB nuevo por si hay liquidez "detras" de la zona sin cazar todavia
var array<float> liqNivelHi = array.new<float>()
var array<float> liqNivelLo = array.new<float>()

liqScoreDe(dir, precio) =>
    resultado = 0.0
    if array.size(sweepBar) > 0
        tol = eqTol * liqCercaPts
        desde = math.max(0, array.size(sweepBar) - liqVentanaBar)
        for i = desde to array.size(sweepBar) - 1
            if array.get(sweepDir, i) == dir and math.abs(array.get(sweepPrice, i) - precio) <= tol
                resultado := 100.0
    resultado

// liquidez SIN BARRER que queda justo detras del borde lejano de la zona
// (el lado opuesto a donde se espera que reaccione el precio): si esta ahi,
// el precio puede atravesar la zona para ir a cazarla antes de revertir de
// verdad -- por eso resta puntos en vez de sumar, a diferencia de un
// barrido ya CONFIRMADO (liqScoreDe), que es lo contrario: senal de que la
// zona nace LIMPIA, sin liquidez pendiente tirando de ella hacia el otro lado
liqEnPeligro(dir, top, bot) =>
    resultado = false
    distMax = eqTol * liqCercaPts * 4   // que tan lejos del borde lejano se sigue considerando "cerca"
    if dir == 1 and array.size(liqNivelLo) > 0
        for i = 0 to array.size(liqNivelLo) - 1
            nivel = array.get(liqNivelLo, i)
            // liquidez pendiente por DEBAJO del piso de la zona alcista
            if nivel <= bot and nivel >= bot - distMax
                resultado := true
    if dir == -1 and array.size(liqNivelHi) > 0
        for i = 0 to array.size(liqNivelHi) - 1
            nivel = array.get(liqNivelHi, i)
            // liquidez pendiente por ENCIMA del techo de la zona bajista
            if nivel >= top and nivel <= top + distMax
                resultado := true
    resultado

// componente final de liquidez del score: 0% si hay liquidez sin cazar
// cerca del borde lejano (riesgo de barrido a traves de la zona) O si no
// hay ninguna senal (sin evidencia positiva, igual que antes de agregar
// este factor); 100% SOLO si nace justo tras un barrido confirmado a su
// favor. Deliberadamente NO se usa un valor "neutral" intermedio: eso
// causo que zonas sin peligro DETECTADO (pero que si lo tenian, solo que
// el detector no lo capturo) subieran de score en vez de quedarse igual.
liqComponenteDe(dir, top, bot) =>
    precioSoporte = dir == 1 ? bot : top
    tieneSoporte = liqScoreDe(dir, precioSoporte) > 0
    tienePeligro = liqEnPeligro(dir, top, bot)
    tienePeligro ? 0.0 : (tieneSoporte ? 100.0 : 0.0)

var float obDispTop = na
var float obDispBot = na
var int   obDispDir = 0
obDispDir := 0

if bullDisp
    idxO = findOrigenAlcista()
    if idxO > 0
        cand = low[idxO]
        if liqLimpiaAlcista(cand)
            obDispTop := high[idxO]
            obDispBot := cand
            obDispDir := 1

if bearDisp
    idxO = findOrigenBajista()
    if idxO > 0
        cand = high[idxO]
        if liqLimpiaBajista(cand)
            obDispTop := cand
            obDispBot := low[idxO]
            obDispDir := -1

// ---------------- deteccion por BOS (estructura interna) ----------------
var float ultPivHi = na
var float ultPivLo = na
var int   obBosDir = 0
obBosDir := 0

// pivote interno confirmado con pivLado velas a cada lado (retraso real:
// ta.pivothigh/low ya solo confirman cuando ya paso esa cantidad de velas)
ph = ta.pivothigh(high, pivLado, pivLado)
pl = ta.pivotlow(low, pivLado, pivLado)
if not na(ph)
    ultPivHi := ph
if not na(pl)
    ultPivLo := pl

if usarBOS
    if not na(ultPivHi) and close > ultPivHi and close > open
        idxO = findOrigenBajista()   // el bos alcista nace de la ultima vela bajista
        if idxO > 0
            obBosTop = high[idxO]
            obBosBot = low[idxO]
            obDispDir := 1
            obDispTop := obBosTop
            obDispBot := obBosBot
            ultPivHi := na
    else if not na(ultPivLo) and close < ultPivLo and close < open
        idxO = findOrigenAlcista()
        if idxO > 0
            obBosTop = high[idxO]
            obBosBot = low[idxO]
            obDispDir := -1
            obDispTop := obBosTop
            obDispBot := obBosBot
            ultPivLo := na

// fuerza de la vela que dispara la zona (desplazamiento o BOS): se calculan
// los 4 componentes conocidos al cierre de ESTA vela (nunca mira adelante) y
// se guardan por separado -- el 5to (FVG) se suma despues si aparece, ver el
// bloque de confluencia FVG mas abajo, que recalcula el texto de la caja
var float obDispFuerza = na
var float obVolS  = na
var float obRngS  = na
var float obLiqS  = na
var float obBiasS = na
obDispFuerza := na
obVolS := na
obRngS := na
obLiqS := na
obBiasS := na
if obDispDir != 0 and not na(avgRng) and avgRng > 0 and not na(avgVol) and avgVol > 0
    obVolS := volScoreDe(volume / avgVol)
    obRngS := rngScoreDe(rng / avgRng)
    obLiqS := liqComponenteDe(obDispDir, obDispTop, obDispBot)
    obBiasS := biasScoreDe(obDispDir, h1Bias)
    obDispFuerza := combinarFuerza(obVolS, obRngS, obLiqS, obBiasS, 0.0)

// ---------------- Fair Value Gap ----------------
fvgAlcista = low > high[2] and (low - high[2]) >= minGap
fvgBajista = high < low[2] and (low[2] - high) >= minGap

// ---------------- gestion de zonas vivas (arrays paralelos) ----------------
var array<box>   cajas   = array.new<box>()
var array<int>   zDir    = array.new<int>()
var array<float> zTop    = array.new<float>()
var array<float> zBot    = array.new<float>()
var array<int>   zNace   = array.new<int>()
var array<bool>  zFVG    = array.new<bool>()
var array<bool>  zFresco = array.new<bool>()   // true mientras el precio no la invalida (y, si aplicarFrescura esta activo, tambien dentro de edadMax)
var array<int>   zResuelveEn = array.new<int>() // bar_index en que se congelo (mitigada/vencida), -1 mientras sigue viva
var array<float> zVolS   = array.new<float>()   // componentes del score de fuerza, guardados para recalcular el texto cuando llegue el bono de FVG
var array<float> zRngS   = array.new<float>()
var array<float> zLiqS   = array.new<float>()
var array<float> zBiasS  = array.new<float>()

// Evita crear una zona "duplicada": durante un solo tramo fuerte, varias
// velas seguidas pueden superar el umbral de desplazamiento por separado
// (cada una mide contra el rango promedio, no sabe que la vela anterior ya
// disparo una zona) -- eso apilaba cajas superpuestas que en realidad son
// la MISMA pierna, no OBs distintos. Si ya existe una zona viva (no
// invalidada) de la misma direccion que se solapa en precio, se descarta la
// nueva candidata y se deja la original (el origen real del movimiento).
solapaZonaViva(dir, top, bot) =>
    resultado = false
    if array.size(cajas) > 0
        for i = 0 to array.size(cajas) - 1
            if array.get(zDir, i) == dir and array.get(zFresco, i)
                exTop = array.get(zTop, i)
                exBot = array.get(zBot, i)
                if not (bot > exTop or top < exBot)
                    resultado := true
    resultado

// crear zona nueva si hubo OB esta vela, no es duplicado de una ya viva, y
// (si se pidio) cumple la fuerza minima
var int totalDetectadas = 0
esDuplicado = obDispDir != 0 and solapaZonaViva(obDispDir, obDispTop, obDispBot)
esDebil = fuerzaMinima > 0 and not na(obDispFuerza) and obDispFuerza < fuerzaMinima
if obDispDir != 0 and not esDuplicado and not esDebil
    totalDetectadas += 1
    textoFuerza = mostrarFuerza and not na(obDispFuerza) ? str.tostring(obDispFuerza) + "%" : ""
    b = box.new(bar_index, obDispTop, bar_index, obDispBot,
         border_color = obDispDir == 1 ? color.new(color.lime, 30) : color.new(color.red, 30),
         bgcolor = obDispDir == 1 ? color.new(color.lime, 85) : color.new(color.red, 85),
         extend = extend.none,
         text = textoFuerza, text_size = size.tiny, text_color = chart.fg_color,
         text_halign = text.align_center, text_valign = text.align_center)
    array.push(cajas, b)
    array.push(zDir, obDispDir)
    array.push(zTop, obDispTop)
    array.push(zBot, obDispBot)
    array.push(zNace, bar_index)
    array.push(zFVG, false)
    array.push(zFresco, true)
    array.push(zResuelveEn, -1)
    array.push(zVolS, obVolS)
    array.push(zRngS, obRngS)
    array.push(zLiqS, obLiqS)
    array.push(zBiasS, obBiasS)

// marcar confluencia con FVG (hacia atras, sobre zonas ya existentes -- igual
// que en Python: el FVG de la vela actual se conoce ahora, se aplica a zonas
// vivas que se solapen, nunca hacia el futuro)
if mostrarFVG and (fvgAlcista or fvgBajista) and array.size(cajas) > 0
    fd = fvgAlcista ? 1 : -1
    fTop = fvgAlcista ? low : low[2]
    fBot = fvgAlcista ? high[2] : high
    for i = 0 to array.size(cajas) - 1
        if array.get(zDir, i) == fd and not (fBot > array.get(zTop, i) or fTop < array.get(zBot, i))
            array.set(zFVG, i, true)
            box.set_border_color(array.get(cajas, i), fd == 1 ? color.new(color.aqua, 10) : color.new(color.orange, 10))
            box.set_border_width(array.get(cajas, i), 2)
            if mostrarFuerza
                nuevaFuerza = combinarFuerza(array.get(zVolS, i), array.get(zRngS, i), array.get(zLiqS, i), array.get(zBiasS, i), 100.0)
                box.set_text(array.get(cajas, i), str.tostring(nuevaFuerza) + "%")

if mostrarFVG and fvgAlcista
    line.new(bar_index[2], high[2], bar_index, high[2], color = color.new(color.aqua, 40), style = line.style_dotted, width = 2)
if mostrarFVG and fvgBajista
    line.new(bar_index[2], low[2], bar_index, low[2], color = color.new(color.orange, 40), style = line.style_dotted, width = 2)

// La caja SOLO crece mientras la zona sigue viva de verdad (igual que en
// Python: cleared -> touchable -> consumida). En cuanto se resuelve -- se
// invalida (precio cierra del otro lado) o se agota la frescura operable --
// se CONGELA su ancho ahi mismo. Asi el tamano de cada caja refleja cuanto
// tiempo estuvo realmente vigente, en vez de una duracion fija identica para
// todas, que era lo que generaba el amontonamiento.
if array.size(cajas) > 0
    for i = array.size(cajas) - 1 to 0
        edad = bar_index - array.get(zNace, i)
        dz = array.get(zDir, i)
        top = array.get(zTop, i)
        bot = array.get(zBot, i)
        invalidada = dz == 1 ? close < bot : close > top
        vencidaPorEdad = aplicarFrescura and edad > edadMax
        if array.get(zFresco, i)
            if vencidaPorEdad or invalidada
                // se resuelve ahora: congelar el ancho, pasar a estilo "historico"
                array.set(zFresco, i, false)
                array.set(zResuelveEn, i, bar_index)
                box.set_border_style(array.get(cajas, i), line.style_dotted)
                box.set_bgcolor(array.get(cajas, i), color.new(dz == 1 ? color.lime : color.red, 95))
            else
                // sigue viva: la caja crece una vela mas
                box.set_right(array.get(cajas, i), bar_index)
        // la vida fantasma se cuenta desde que se RESOLVIO, no desde que nacio --
        // si no, una zona mitigada al instante quedaba dibujada casi tanto tiempo
        // como una que tardo en resolverse, amontonando decenas de zonas fantasma
        if not array.get(zFresco, i)
            edadResuelta = bar_index - array.get(zResuelveEn, i)
            borrar = not verTodo or edadResuelta > vidaFantasma
            if borrar
                box.delete(array.get(cajas, i))
                array.remove(cajas, i)
                array.remove(zDir, i)
                array.remove(zTop, i)
                array.remove(zBot, i)
                array.remove(zNace, i)
                array.remove(zFVG, i)
                array.remove(zFresco, i)
                array.remove(zResuelveEn, i)
                array.remove(zVolS, i)
                array.remove(zRngS, i)
                array.remove(zLiqS, i)
                array.remove(zBiasS, i)

// ============================================================================
// LIQUIDEZ: pivotes confirmados (donde suelen descansar stops) + clusters de
// maximos/minimos "iguales" (varios pivotes casi al mismo precio = mas
// liquidez acumulada ahi, el iman clasico de ICT). Una vez que el precio
// BARRE el nivel (mecha lo supera y cierra de vuelta), se marca como
// consumido y desaparece -- asi el grafico solo muestra liquidez pendiente,
// no ya cazada.
// ============================================================================
liqPH = ta.pivothigh(high, liqLado, liqLado)
liqPL = ta.pivotlow(low, liqLado, liqLado)

var array<line>  liqLineasHi = array.new<line>()
var array<int>   liqNaceHi   = array.new<int>()
var array<int>   liqTocHi    = array.new<int>()   // cuantos pivotes cercanos = "iguales"
var array<line>  liqLineasLo = array.new<line>()
var array<int>   liqNaceLo   = array.new<int>()
var array<int>   liqTocLo    = array.new<int>()
var array<line>  liqGhost           = array.new<line>() // lineas ya barridas, en cuenta regresiva antes de borrarse
var array<int>   liqGhostResuelveEn = array.new<int>()

if mostrarLiq and not na(liqPH)
    origen = bar_index - liqLado
    // buscar si ya hay un nivel "igual" cerca -> engordar liquidez ahi
    fusion = false
    if array.size(liqNivelHi) > 0
        for i = 0 to array.size(liqNivelHi) - 1
            if math.abs(array.get(liqNivelHi, i) - liqPH) <= eqTol
                array.set(liqTocHi, i, array.get(liqTocHi, i) + 1)
                n = array.get(liqTocHi, i)
                line.set_width(array.get(liqLineasHi, i), math.min(1 + n, 4))
                line.set_x2(array.get(liqLineasHi, i), bar_index)
                fusion := true
    if not fusion
        ln = line.new(origen, liqPH, bar_index, liqPH, color = color.new(color.fuchsia, 20), style = line.style_dashed, width = 1)
        array.push(liqLineasHi, ln)
        array.push(liqNivelHi, liqPH)
        array.push(liqNaceHi, origen)
        array.push(liqTocHi, 1)

if mostrarLiq and not na(liqPL)
    origen = bar_index - liqLado
    fusion = false
    if array.size(liqNivelLo) > 0
        for i = 0 to array.size(liqNivelLo) - 1
            if math.abs(array.get(liqNivelLo, i) - liqPL) <= eqTol
                array.set(liqTocLo, i, array.get(liqTocLo, i) + 1)
                n = array.get(liqTocLo, i)
                line.set_width(array.get(liqLineasLo, i), math.min(1 + n, 4))
                line.set_x2(array.get(liqLineasLo, i), bar_index)
                fusion := true
    if not fusion
        ln = line.new(origen, liqPL, bar_index, liqPL, color = color.new(color.teal, 20), style = line.style_dashed, width = 1)
        array.push(liqLineasLo, ln)
        array.push(liqNivelLo, liqPL)
        array.push(liqNaceLo, origen)
        array.push(liqTocLo, 1)

// barrido: la mecha supera el nivel y el CIERRE vuelve adentro -> se consume
if mostrarLiq and array.size(liqNivelHi) > 0
    for i = array.size(liqNivelHi) - 1 to 0
        nivel = array.get(liqNivelHi, i)
        barrido = high > nivel + eqTol and close < nivel
        vencido = bar_index - array.get(liqNaceHi, i) > liqEdadMax
        if barrido or vencido
            line.set_x2(array.get(liqLineasHi, i), bar_index)
            if barrido
                line.set_color(array.get(liqLineasHi, i), color.new(color.fuchsia, 0))
                label.new(bar_index, nivel, "barrido", style = label.style_label_down, size = size.tiny, color = color.new(color.fuchsia, 60), textcolor = color.white)
                // barrido de MAXIMOS favorece un OB BAJISTA a continuacion
                array.push(sweepBar, bar_index)
                array.push(sweepPrice, nivel)
                array.push(sweepDir, -1)
                if array.size(sweepBar) > 200
                    array.shift(sweepBar)
                    array.shift(sweepPrice)
                    array.shift(sweepDir)
                // se deja de rastrear activamente, pero se conserva un rato
                // como "fantasma" (mismo criterio que las cajas de OB) para
                // que se vea confirmado el barrido antes de desaparecer
                array.push(liqGhost, array.get(liqLineasHi, i))
                array.push(liqGhostResuelveEn, bar_index)
            else
                // vencida sin barrer: no confirmo nada, se borra sin dejar rastro
                line.delete(array.get(liqLineasHi, i))
            array.remove(liqLineasHi, i)
            array.remove(liqNivelHi, i)
            array.remove(liqNaceHi, i)
            array.remove(liqTocHi, i)

if mostrarLiq and array.size(liqNivelLo) > 0
    for i = array.size(liqNivelLo) - 1 to 0
        nivel = array.get(liqNivelLo, i)
        barrido = low < nivel - eqTol and close > nivel
        vencido = bar_index - array.get(liqNaceLo, i) > liqEdadMax
        if barrido or vencido
            line.set_x2(array.get(liqLineasLo, i), bar_index)
            if barrido
                line.set_color(array.get(liqLineasLo, i), color.new(color.teal, 0))
                label.new(bar_index, nivel, "barrido", style = label.style_label_up, size = size.tiny, color = color.new(color.teal, 60), textcolor = color.white)
                // barrido de MINIMOS favorece un OB ALCISTA a continuacion
                array.push(sweepBar, bar_index)
                array.push(sweepPrice, nivel)
                array.push(sweepDir, 1)
                if array.size(sweepBar) > 200
                    array.shift(sweepBar)
                    array.shift(sweepPrice)
                    array.shift(sweepDir)
                array.push(liqGhost, array.get(liqLineasLo, i))
                array.push(liqGhostResuelveEn, bar_index)
            else
                line.delete(array.get(liqLineasLo, i))
            array.remove(liqLineasLo, i)
            array.remove(liqNivelLo, i)
            array.remove(liqNaceLo, i)
            array.remove(liqTocLo, i)

// limpieza de las lineas de liquidez "fantasma" (barridas), mismo criterio
// de vida que las cajas de OB (vidaFantasma) para no dejarlas dibujadas para
// siempre -- antes NUNCA se borraban (bug: se sacaban del array que las
// rastreaba pero la linea seguia en el grafico indefinidamente)
if array.size(liqGhost) > 0
    for i = array.size(liqGhost) - 1 to 0
        if bar_index - array.get(liqGhostResuelveEn, i) > vidaFantasma
            line.delete(array.get(liqGhost, i))
            array.remove(liqGhost, i)
            array.remove(liqGhostResuelveEn, i)

// ---------------- sombreado de sesion ----------------
enSesion = not na(time(timeframe.period, sesIni, "America/New_York"))
bgcolor(mostrarSesion and enSesion ? color.new(color.blue, 92) : na)

// ---------------- tabla resumen ----------------
var table info = table.new(position.top_right, 1, 3, bgcolor = color.new(color.black, 70), border_width = 1)
if barstate.islast
    table.cell(info, 0, 0, "OB+FVG Visualizador", text_color = color.white, text_size = size.small)
    table.cell(info, 0, 1, "OB detectados en total: " + str.tostring(totalDetectadas), text_color = color.white, text_size = size.small)
    table.cell(info, 0, 2, "Visibles ahora: " + str.tostring(array.size(cajas)) + " (operables: contorno solido)", text_color = color.white, text_size = size.small)
